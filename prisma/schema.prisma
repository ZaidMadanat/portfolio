// zaidmadanat.com data model (spec §8).
// CHECK constraints (ratings 1–10, price 1–4, favourite position 1–4) live in
// the init migration's SQL; Prisma's schema language can't express them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum Category {
  NOTES
  STATISTICS
  COMPUTER_SCIENCE
  PHILOSOPHY
  FILM
  FOOD
  MUSIC
  PROJECTS
}

enum ReviewKind {
  FOOD
  FILM
  ALBUM
  CONCERT
}

enum Region {
  SAN_FRANCISCO
  EAST_BAY
  NORTH_BAY
  PENINSULA
  SOUTH_BAY
}

enum FilmEntryType {
  WATCH
  REVIEW
}

enum FavoriteKind {
  FILM
  ALBUM
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

enum EmailSendStatus {
  QUEUED
  /// Claimed by a running drain (claimedAt says when); never picked by another drain.
  SENDING
  SENT
  FAILED
}

enum SyncSource {
  LETTERBOXD
  STATSFM
  STRAVA
  HOUSEKEEPING
}

// ---------------------------------------------------------------- Blog

model Post {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String     @default("")
  coverMediaId   String?
  coverMedia     Media?     @relation("PostCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  blocks         Json
  /// Rendered from `blocks` on every save (spec §7.2).
  html           String     @default("")
  category       Category
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?
  /// Set once the new-post email has gone out; re-publishing never sends again.
  notifiedAt     DateTime?
  readingMinutes Int        @default(1)
  templateId     String?
  template       Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// 1:1 link to a review. Deleting the review clears it (the rating box disappears).
  reviewId       String?    @unique
  review         Review?    @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tags       PostTag[]
  media      PostMedia[]
  redirects  Redirect[]
  emailSends EmailSend[]
  stat       PostStat?

  @@index([status, publishedAt])
}

/// Media referenced by a post's blocks, kept in step on every save.
model PostMedia {
  postId  String
  mediaId String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([postId, mediaId])
  @@index([mediaId])
}

/// Old slugs 308-redirect to the post's current slug.
model Redirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model Template {
  id        String    @id @default(cuid())
  name      String
  builtIn   Boolean   @default(false)
  /// Built-ins are 1–7 in spec order (set by the seed); saved templates keep 1000.
  sortOrder Int       @default(1000)
  category  Category?
  blocks    Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  posts Post[]
}

// ---------------------------------------------------------------- Reviews

model Review {
  id        String     @id @default(cuid())
  kind      ReviewKind
  title     String
  /// Whole number 1–10 (CHECK constraint in the init migration).
  rating    Int
  date      DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  post   Post?
  photos ReviewMedia[]

  // FOOD
  address       String?
  lat           Float?
  lng           Float?
  cuisine       String?
  /// 1–4 ($–$$$$), CHECK constraint in the init migration.
  price         Int?
  neighbourhood String?
  city          String?
  region        Region?
  dishes        Dish[]

  // FILM
  filmLogId String?  @unique
  filmLog   FilmLog? @relation(fields: [filmLogId], references: [id], onDelete: SetNull)

  // ALBUM (artist is shared with CONCERT)
  artist         String?
  year           Int?
  coverUrl       String?
  statsfmAlbumId String?

  // CONCERT
  venue     String?
  highlight String?

  favorites Favorite[]

  @@index([kind, date])
}

model Dish {
  id        String  @id @default(cuid())
  reviewId  String
  review    Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  name      String
  mustOrder Boolean @default(false)
  order     Int

  @@index([reviewId, order])
}

model ReviewMedia {
  reviewId String
  mediaId  String
  order    Int    @default(0)
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([reviewId, mediaId])
  @@index([mediaId])
}

model Favorite {
  id        String       @id @default(cuid())
  kind      FavoriteKind
  /// 1–4, CHECK constraint in the init migration.
  position  Int
  filmLogId String?
  filmLog   FilmLog?     @relation(fields: [filmLogId], references: [id], onDelete: SetNull)
  reviewId  String?
  review    Review?      @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  // Snapshot, so free-text favourites still render.
  title     String
  artist    String?
  year      Int?
  coverUrl  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([kind, position])
}

model GeocodeCache {
  id                String   @id @default(cuid())
  normalisedAddress String   @unique
  lat               Float
  lng               Float
  neighbourhood     String?
  city              String?
  raw               Json
  createdAt         DateTime @default(now())
}

// ---------------------------------------------------------------- Synced data

/// One Letterboxd diary feed item, upserted by guid.
model FilmLog {
  id                  String        @id @default(cuid())
  letterboxdGuid      String        @unique
  entryType           FilmEntryType
  title               String
  year                Int
  tmdbId              Int?
  /// 0.5–5 in half steps; null when the feed has no memberRating.
  stars               Decimal?      @db.Decimal(2, 1)
  /// stars × 2, 1–10 (CHECK constraint in the init migration).
  rating              Int?
  watchedAt           DateTime      @db.Date
  posterUrl           String?
  rewatch             Boolean       @default(false)
  liked               Boolean       @default(false)
  hasLetterboxdReview Boolean       @default(false)
  url                 String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  review    Review?
  favorites Favorite[]

  @@index([watchedAt])
}

/// The latest stats.fm 7-day window. Each sync replaces the whole table.
model AlbumListen {
  id             String   @id @default(cuid())
  statsfmAlbumId String
  title          String
  artist         String
  year           Int?
  coverUrl       String
  rank           Int
  streams        Int
  windowStart    DateTime
  windowEnd      DateTime
}

model StravaActivity {
  /// Strava's activity id, as a string (it overflows Int, and BigInt can't be JSON-cached).
  id        String   @id
  name      String
  sportType String
  distanceM Float
  movingS   Int
  startAt   DateTime
  url       String

  @@index([startAt])
}

model ProviderToken {
  provider     String   @id
  accessToken  String
  /// Rotated on every refresh: Strava's old refresh token can stop working.
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model SyncRun {
  id           String     @id @default(cuid())
  source       SyncSource
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  ok           Boolean    @default(false)
  message      String     @default("")
  itemsChanged Int        @default(0)

  @@index([source, startedAt])
}

// ---------------------------------------------------------------- Media

model Media {
  id          String   @id @default(cuid())
  blobUrl     String
  filename    String
  width       Int
  height      Int
  bytes       Int
  alt         String   @default("")
  /// ~16 px WebP data URL for a blur-up placeholder (spec §7.1).
  blurDataUrl String   @default("")
  createdAt   DateTime @default(now())

  coverOf Post[]        @relation("PostCover")
  posts   PostMedia[]
  reviews ReviewMedia[]
}

// ---------------------------------------------------------------- Email

model Subscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           SubscriberStatus @default(PENDING)
  confirmToken     String           @unique
  unsubscribeToken String           @unique
  createdAt        DateTime         @default(now())
  confirmedAt      DateTime?

  emailSends EmailSend[]
}

/// Drives resumable new-post sends (spec §9.4).
model EmailSend {
  id           String          @id @default(cuid())
  postId       String
  subscriberId String
  post         Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  subscriber   Subscriber      @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status       EmailSendStatus @default(QUEUED)
  /// Set when a drain claims the row (status SENDING); stale claims are re-queued.
  claimedAt    DateTime?
  sentAt       DateTime?
  createdAt    DateTime        @default(now())

  @@unique([postId, subscriberId])
  @@index([status])
}

/// Daily copy of the Redis counters for the admin dashboard. Public pages never read it.
model PostStat {
  postId   String   @id
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  views    Int      @default(0)
  likes    Int      @default(0)
  syncedAt DateTime
}

// ---------------------------------------------------------------- Auth

// better-auth models
// Generated by `npx auth@1.7.14 generate` (Better Auth 1.7.14), plus a unique
// (providerId, accountId) so one GitHub identity can never back two users.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
