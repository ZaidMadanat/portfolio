{
  "name": "zaidmadanat-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:static": "node scripts/check-static-routes.mjs",
    "lighthouse": "lhci autorun",
    "db:up": "docker compose up -d db",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@blocknote/core": "0.56.0",
    "@blocknote/mantine": "0.56.0",
    "@blocknote/react": "0.56.0",
    "@blocknote/server-util": "0.56.0",
    "@calcom/embed-react": "1.5.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.40.0",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.14",
    "fast-xml-parser": "5.11.2",
    "katex": "0.19.1",
    "maplibre-gl": "6.14.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "@blocknote/server-util": {
      "jsdom": "26.1.0"
    }
  }
